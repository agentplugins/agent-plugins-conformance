{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "recovery-invalid": {
      "type": "stdio"
    },
    "recovery-valid": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/dist/probe.mjs"]
    },
    "recovery-cwd-escape": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/dist/probe.mjs", "recovery-cwd-escape"],
      "cwd": "./.."
    }
  }
}
